# =============================================================================
# Web app environment. Copy to ".env" (git-ignored) and fill in.
#   cp .env.example .env
#
# Everything here is PUBLIC by design: Vite bundles VITE_* variables into the
# browser JavaScript, so anyone who loads the site can read them. Never put a
# service-role key, database URL, or any other secret in this file.
# =============================================================================

# Supabase project URL. The auth client uses it for AUTH ONLY (login/session). All data
# goes through the KnowledgeBase Edge Function API, whose URL is derived as
# <VITE_SUPABASE_URL>/functions/v1/kb — the browser never queries the database.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase *anon* (public) key — used for auth and as the `apikey` header. The API
# also requires a signed-in user's token, so this key alone cannot read data.
VITE_SUPABASE_ANON_KEY=your-anon-public-key
