# =============================================================================
# Mock mode: `npm run dev:mock` / `npm run build:mock` (vite --mode mock).
# Committed on purpose — every value here is a DUMMY. In mock mode nothing talks to a
# real backend: MSW (src/mocks) answers both the KB API and Supabase Auth from
# synthetic fixtures. These values override `.env` in this mode.
# =============================================================================

# Fake project URL. Requests to it never leave the browser; the mock intercepts them.
# (https so it also works when the app itself is served over https — no mixed content.)
VITE_SUPABASE_URL=https://mock.kb.local

# Not a real key — just a placeholder the mock checks for in the `apikey` header.
VITE_SUPABASE_ANON_KEY=mock-anon-key-not-a-real-key

# Turns the mock on (src/main.tsx).
VITE_MOCK_API=1
